# .env.example - Environment Variables Template for ReSearchAI

# Groq Cloud API Key (Required for multi-agent LLM inference)
# Get yours at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Semantic Scholar API Key (Optional, enhances rate limits for literature discovery)
# Get yours at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Vector Database & Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Backend Service URL (Used by Streamlit in Docker or custom deployment)
BACKEND_URL=http://localhost:8000
